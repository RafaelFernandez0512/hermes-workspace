# Hermes Workspace + Hermes Agent — Docker environment template
#
# Copy to .env and fill in the required values:
#   cp .env.example .env
#
# Required for the Docker stack:
#   - at least one model/provider key for hermes-agent
#   - API_SERVER_KEY
#   - HERMES_PASSWORD
#
# The compose file wires the internal service URLs automatically:
#   HERMES_API_URL=http://hermes-agent:8642
#   HERMES_DASHBOARD_URL=http://hermes-agent:9119
#
# If you expose the workspace through HTTPS (proxy / domain / Tailscale Serve),
# set COOKIE_SECURE=1 and TRUST_PROXY=1.

# ───────────────────────────────────────────────────────────────
# Provider keys for hermes-agent (set the ones you actually use)
# ───────────────────────────────────────────────────────────────
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=

# ───────────────────────────────────────────────────────────────
# Agent auth (required)
# ───────────────────────────────────────────────────────────────
# The agent container expects API_SERVER_KEY when API_SERVER_HOST=0.0.0.0.
# The workspace uses the same token as HERMES_API_TOKEN.
API_SERVER_KEY=
# HERMES_API_TOKEN=

# ───────────────────────────────────────────────────────────────
# Workspace auth (required for Docker)
# ───────────────────────────────────────────────────────────────
HERMES_PASSWORD=
# CLAUDE_PASSWORD=  # legacy alias still accepted by the app

# ───────────────────────────────────────────────────────────────
# URLs used inside the Docker network
# ───────────────────────────────────────────────────────────────
HERMES_API_URL=http://hermes-agent:8642
HERMES_DASHBOARD_URL=http://hermes-agent:9119

# ───────────────────────────────────────────────────────────────
# HTTP / proxy behavior
# ───────────────────────────────────────────────────────────────
# Plain HTTP (localhost, LAN, Tailscale direct) should use 0.
# HTTPS via Caddy / reverse proxy should use 1.
COOKIE_SECURE=0

# Trust X-Forwarded-* headers only when you are behind a trusted proxy.
TRUST_PROXY=0

# ───────────────────────────────────────────────────────────────
# Optional proxy / domain-only deployment
# ───────────────────────────────────────────────────────────────
# HERMES_DOMAIN=workspace.example.com
# CADDY_EMAIL=admin@example.com
# TAILSCALE_IP=100.110.19.120  # run `tailscale ip -4` and paste the result here for host binds
# HERMES_DASHBOARD_INSECURE=1  # only if the agent dashboard auth gate blocks internal Docker binds

# ───────────────────────────────────────────────────────────────
# Optional developer overrides
# ───────────────────────────────────────────────────────────────
# HERMES_UID=1000
# HERMES_GID=1000
